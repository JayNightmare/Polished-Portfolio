# MongoDB connection URI
MONGO_URI=mongodb://localhost:27017/polished-portfolio

# Public site URL used for sitemap generation
SITE_URL=https://portfolio.nexusgit.info

# Admin secret for blog management
VITE_ADMIN_TOKEN=your-admin-secret-here

# Provider-neutral AI chat configuration
# These map to any OpenAI-compatible endpoint. The server still falls back to OPENAI_* for backward compatibility.
AI_API_KEY=your-provider-api-key-here
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=https://openrouter.ai/api/v1

# Example OpenRouter model slug
# AI_MODEL=openai/gpt-4.1-mini

# Example OpenAI-compatible Hugging Face router endpoint
# AI_BASE_URL=https://router.huggingface.co/v1
# AI_MODEL=openai/gpt-oss-120b

# Optional GitHub context for stronger project answers
GITHUB_USERNAME=JayNightmare
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# Server port (optional)
PORT=3001